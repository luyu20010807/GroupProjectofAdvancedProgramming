<view class="container" wx:if="{{order}}"><view class="card"><view class="row between"><view class="status">{{order.status}}</view><view class="price">¥{{order.total}}</view></view><view class="title">{{order.order_no}}</view><view class="muted">{{order.merchant}}</view><view class="divider"/><view wx:for="{{order.items}}" wx:key="name" class="row between"><text>{{item.name}} × {{item.quantity}}</text><text>¥{{item.unit_price}}</text></view><view class="muted">物流：{{order.tracking_no || '暂无'}}</view><button wx:if="{{order.status==='pending_payment'}}" class="primary" bindtap="pay">模拟支付</button><button wx:if="{{order.status==='shipped'}}" class="primary" bindtap="confirm">确认收货</button><button wx:if="{{order.status==='paid'||order.status==='shipped'||order.status==='completed'}}" bindtap="refund">申请售后</button></view><view class="card"><view class="title">售后记录</view><view wx:for="{{order.refunds}}" wx:key="id"><view class="status">{{item.status}}</view><view>{{item.refund_no}} · {{item.reason}}</view></view><view wx:if="{{order.refunds.length===0}}" class="muted">暂无售后记录</view></view></view>
