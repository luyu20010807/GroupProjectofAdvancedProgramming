<view class="container" wx:if="{{product}}"><view class="card"><image class="product-image" mode="aspectFill" src="http://127.0.0.1:8000{{product.image_url}}"/><view class="tag">{{product.category}}</view><view class="title">{{product.name}}</view><view class="muted">{{product.description}}</view><view class="price">¥{{product.price}}</view><view class="row"><input class="input" type="number" value="1" bindinput="onQty"/><button class="primary" bindtap="add">加入购物车</button></view></view></view>
