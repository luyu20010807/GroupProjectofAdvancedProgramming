<view class="container"><view class="card"><view class="title">申请售后</view><radio-group bindchange="onType"><label class="row"><radio value="return_refund" checked="{{refund_type==='return_refund'}}"/>退货退款</label><label class="row"><radio value="refund_only" checked="{{refund_type==='refund_only'}}"/>仅退款（仅未发货订单）</label></radio-group><input class="input" value="{{reason}}" bindinput="onReason" placeholder="售后原因"/><textarea class="input" value="{{description}}" bindinput="onDescription" placeholder="详细说明问题和期望处理方式"/><button class="primary" bindtap="submit">提交申请</button></view></view>
