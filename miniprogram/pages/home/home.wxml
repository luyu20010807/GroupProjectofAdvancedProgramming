<view class="container"><view class="card"><view class="title">精选商品</view><view class="muted">网页、PWA 与小程序共享库存和订单数据</view></view><view wx:for="{{products}}" wx:key="id" class="card" bindtap="open" data-id="{{item.id}}"><image class="product-image" mode="aspectFill" src="http://127.0.0.1:8000{{item.image_url}}"/><view class="tag">{{item.category}}</view><view class="title">{{item.name}}</view><view class="muted">{{item.merchant}} · 库存 {{item.stock}}</view><view class="price">¥{{item.price}}</view></view><view wx:if="{{!loading && products.length===0}}" class="empty">暂无商品</view></view>
