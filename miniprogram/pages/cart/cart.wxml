<view class="container"><view wx:for="{{items}}" wx:key="id" class="card"><view class="row between"><view><view class="title">{{item.product.name}}</view><view class="muted">¥{{item.product.price}} × {{item.quantity}}</view></view><view class="danger" data-id="{{item.id}}" bindtap="remove">删除</view></view></view><view wx:if="{{items.length}}" class="card"><view class="row between"><view class="title">合计</view><view class="price">¥{{total}}</view></view><button class="primary" bindtap="checkout">提交订单</button></view><view wx:else class="empty">购物车为空</view></view>
