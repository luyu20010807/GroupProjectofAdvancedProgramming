<view class="container"><view wx:for="{{orders}}" wx:key="id" class="card" bindtap="open" data-id="{{item.id}}"><view class="row between"><view><view class="status">{{item.status}}</view><view class="title">{{item.order_no}}</view><view class="muted">{{item.merchant}}</view></view><view class="price">¥{{item.total}}</view></view></view><view wx:if="{{orders.length===0}}" class="empty">暂无订单</view></view>
