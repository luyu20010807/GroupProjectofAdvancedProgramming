page{background:#f6f7f9;color:#18202a;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.container{padding:24rpx}.card{background:#fff;border-radius:24rpx;padding:24rpx;margin-bottom:20rpx;box-shadow:0 12rpx 30rpx rgba(35,42,54,.06)}.title{font-size:38rpx;font-weight:800}.muted{color:#747d87;font-size:24rpx}.price{color:#d71920;font-size:34rpx;font-weight:800}.primary{background:#d71920!important;color:#fff!important;border-radius:18rpx}.danger{color:#d71920}.row{display:flex;align-items:center;gap:16rpx}.between{justify-content:space-between}.input{border:1rpx solid #ddd;border-radius:14rpx;padding:18rpx;margin:14rpx 0;background:#fff}.tag{display:inline-block;background:#fff0f1;color:#b0141b;border-radius:99rpx;padding:5rpx 12rpx;font-size:22rpx}.empty{text-align:center;color:#888;padding:80rpx 20rpx}.product-image{width:100%;height:300rpx;border-radius:18rpx;background:#e7e9ee}.divider{height:1rpx;background:#eee;margin:20rpx 0}.status{font-weight:700;color:#b76e00}
